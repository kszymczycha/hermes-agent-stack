# =============================================================================
# Hermes Agent stack — deployment variables read by Docker Compose.
#
# Copy to .env, fill in the values, and keep it private:
#   cp .env.example .env && chmod 600 .env
#
# Hermes' own secrets (LLM API keys, bot tokens) do NOT belong here. They go
# into $HERMES_DATA_DIR/.env, which is read by the agent at /opt/data/.env.
# =============================================================================

# -----------------------------------------------------------------------------
# Data directory (absolute path on the host)
# Defaults to $HOME/.hermes when unset. Contains config.yaml, .env, SOUL.md,
# memories/, sessions/, skills/ and logs/.
# -----------------------------------------------------------------------------
# HERMES_DATA_DIR=/home/pi/.hermes

# -----------------------------------------------------------------------------
# Image version
# Use an explicit release tag, not "latest". Available tags:
# https://hub.docker.com/r/nousresearch/hermes-agent/tags
# -----------------------------------------------------------------------------
HERMES_IMAGE_TAG=v0.23.1

# -----------------------------------------------------------------------------
# Runtime ownership
# UID/GID that will own files in HERMES_DATA_DIR. Check yours with:
#   id -u && id -g
# -----------------------------------------------------------------------------
HERMES_UID=1000
HERMES_GID=1000

# -----------------------------------------------------------------------------
# Dashboard authentication (required)
# -----------------------------------------------------------------------------
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=
# Generate a stable session secret: openssl rand -hex 32
HERMES_DASHBOARD_SECRET=

# -----------------------------------------------------------------------------
# Optional OpenAI-compatible API server (port 8642)
# Disabled by default. If you enable it, also uncomment the 8642 port mapping
# in docker-compose.yaml and set a key of at least 8 characters.
# -----------------------------------------------------------------------------
API_SERVER_ENABLED=false
# API_SERVER_KEY=
# API_SERVER_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Resource limits
# On a 4 GB Raspberry Pi, 2G–3G is a sensible range. Browser automation
# (Playwright/Chromium) is the most memory-hungry feature.
# -----------------------------------------------------------------------------
HERMES_MEMORY_LIMIT=3G
HERMES_CPUS=2.0

# =============================================================================
# Hermes application secrets go into $HERMES_DATA_DIR/.env, for example:
#
#   OPENROUTER_API_KEY=sk-or-...
#   # OPENAI_API_KEY=...   # optional alternative, provider openai-api
#   TELEGRAM_BOT_TOKEN=123456:ABC...
#   TELEGRAM_ALLOWED_USERS=111111111,222222222
#
# See README.md → Configuration for details.
# =============================================================================
